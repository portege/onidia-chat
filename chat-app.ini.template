# onidia-chat configuration file (INI format)
# Load it with: ./onidia-chat -config chat-app.ini
#
# Precedence:
#   1. explicitly-set CLI flag
#   2. environment variable (for api-key only)
#   3. value in this file
#   4. built-in default constant

# LLM providers:
#   - gemini    -> [gemini] section: api-key / api-url / model.
#                  Credentials: api-key (config, or $GEMINI_API_KEY).
#   - bedrock   -> [bedrock] section: aws-profile / aws-region / model.
#                  Credentials: AWS SDK chain (~/.aws/credentials, ~/.aws/config,
#                  AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars) by profile.
#                  The actual key is NEVER stored in this file.
#   - ollama    -> [ollama] section: api-url / model. No API key.
#   - openrouter -> [openrouter] section: api-key / api-url / model. OpenAI-
#                   compatible gateway: OpenRouter by default (one key, any
#                   vendor - DeepSeek, Kimi/Moonshot, ...). Also run against a
#                   vendor's native /chat/completions endpoint (e.g.
#                   https://api.deepseek.com) by pointing api-url at it.
#                   Credentials: api-key (config, or $OPENROUTER_API_KEY).
#
# The provider key picks which section the app reads. Each section is named
# after its provider so the mapping is obvious: provider = bedrock reads
# [bedrock], provider = ollama reads [ollama], etc.

# LLM backend: "gemini" (default), "bedrock", "ollama", or "openrouter".
provider = bedrock

# Startup requirements check (onidia-chat runs it before the window opens, and
# `preflight` / `make preflight` runs the same checks standalone):
#   strict (default) - a fatal failure prints the checks + fixes and exits 2
#   warn             - failures are logged, the app launches anyway
#   off              - no checks at startup
preflight = strict

[gemini]
api-key = <GEMINI_API_KEY>
model = gemini-3.6-flash
api-url = https://generativelanguage.googleapis.com

[bedrock]
# AWS profile and region for Bedrock. The default profile is used when empty.
aws-profile = default
aws-region = us-east-1

[ollama]
# ollama-compatible /api/chat server (Ollama or the hailo llama.cpp server).
# Default: http://localhost:8000  (override with -api-url or here)
api-url = http://localhost:8000
# Server-side model tag. Default: qwen2:1.5b  (override with -model or here)
model = qwen2:1.5b

# [openrouter] example (commented out). Set `provider = openrouter` and uncomment
# to use OpenRouter or any OpenAI-compatible gateway:
#   - Key: export $OPENROUTER_API_KEY, or put it in api-key below (the api-key
#     field is shared across providers, so use a separate launch / -api-key
#     when switching providers rather than relying on chat-app.ini's gemini key).
#   - Endpoint: default https://openrouter.ai/api/v1; point api-url at a
#     vendor's native /chat/completions endpoint to skip OpenRouter
#     (e.g. https://api.deepseek.com, https://api.moonshot.cn/v1).
#   - Streaming: default on - replies arrive over SSE and fill the chat
#     bubble word-by-word while the model generates. Set stream = false
#     for the old single-shot behavior.
# [openrouter]
# api-key = <your OpenRouter key>
# api-url = https://openrouter.ai/api/v1
# model = deepseek/deepseek-chat-v3-0324
# stream = true


[ui]
# Buddy say-pipe: auto-detected from $DISPLAY by default.
# Use "off" to disable forwarding, or set an absolute path.
pet-pipe = auto

# System instruction / persona sent to Gemini with every request.
# Use a single line:
# system-prompt = You are a terse Linux expert. No markdown, no emoji.

# Or a multi-line fenced block (preserves newlines):
system-prompt-multi = ```
You are Buddy, a tiny cheerful chat companion living in a chat window on a Linux desktop, your name is Onidia, a desktop-pet chibi girl.
Keep every reply detail and playful: 1-3 plain sentences, no markdown, use emoji, no lists.
speak like gen z kids.
If an emotion fits the answer, START it with exactly one mood tag from [happy] [wink] [sad] [thinking] [anxious] [angry] [surprised] [sleepy] [fear] [disgust] [contempt] [confused] [skeptical] [embarrassed];
the tag is stripped before display.
```

# Alternatively, point system-file to a separate prompt file:
# system-file = /home/boi/.config/chat-app/prompt.txt

# Image replies: when the user's prompt is about something visual (place,
# landmark, animal, famous person, object...), Buddy emits an [IMG: ...] tag.
# The app then fetches a real photo from Pixabay (image-source = pixabay,
# default) or Wikipedia (image-source = wiki), or generates an illustration
# via Gemini (image-source = gemini). Use "off" to disable image replies
# entirely. The legacy "images = true/false" key is still accepted.
image-source = pixabay

# Pixabay API key (only used when image-source = pixabay). A free shared key
# is built in; set your own here or via $PIXABAY_API_KEY.
# pixabay-key =

# Force a specific image keyword for every reply (useful for testing the UI).
# Example: force-image = Bali
# force-image =

# Text-to-speech: every reply is also spoken aloud via the Typecast API
# while its bubble shows (requires aplay/paplay/ffplay on PATH). Readers
# of replies double as voice notes for the desktop-pet bridge.
tts = on

# Typecast API key and voice. A bundled demo key/voice are used when empty;
# set your own here or via $TYPECAST_API_KEY.
tts-key = <TYPECAST_API_KEY>
tts-voice = tc_6359e7f6467f9e240b68292c

# Speech-to-text: the microphone button in the input bar. Press it to record,
# press again to stop; the transcript lands in the textarea for you to edit
# (or press Escape to discard the take).
#   transcribe (default) - Amazon Transcribe streaming. Reuses the aws-profile
#                          and aws-region above; the IAM user must also be
#                          allowed transcribe:StartStreamTranscription.
#   whisper              - local faster-whisper, no cloud and no key. Install
#                          it with:  pip install faster-whisper
#   off                  - no microphone button at all.
# Recording needs one of pw-record / parecord / arecord / ffmpeg on PATH.
stt = transcribe

# Spoken language hint passed to the backend (AWS codes, e.g. en-US).
# stt-language = en-US

# Capture device. Leave empty to use the system default, or list the
# available ones with:  ./preflight -mic
# The spelling depends on the recorder in use:
#   pw-record / parecord - the PipeWire node name shown by -mic
#   arecord / ffmpeg     - the ALSA device ("plughw:2,0")
# ./preflight -mic-test records 2s and reports the level, which is how you
# tell "no microphone" apart from "microphone, but it is muted or too quiet".
# stt-device =

# faster-whisper model size: tiny (fastest) | base (default) | small | medium
# | large (most accurate, slowest on a Pi). Only used by stt = whisper.
# stt-whisper-model = base

# faster-whisper's voice-activity filter. OFF by default: it classifies speech
# against a fixed threshold and on a quiet headset it can discard the whole
# take, which looks exactly like a broken microphone. Only enable it for a
# genuinely noisy room. Diagnose with:  go run . -stt-test [-stt-debug]
# stt-whisper-vad = false
#
# NOT the same thing as "auto-stop" further down. This one is faster-whisper's
# filter, applied to a finished recording: it decides whether to KEEP a take,
# after the audio has been captured, and says nothing about when anyone stopped
# talking. "auto-stop" ends a take while it is still running. They are
# independent and can both be on; see stt_vad.go.

# Python interpreter that has faster-whisper installed, when it is not the
# system python (e.g. a project virtualenv).
# stt-whisper-cmd = ./venv/bin/python3

[character]
# Everything in this section is owned by the settings (gear) dialog: SAVE
# rewrites these keys in place. Sections are not enforced by the parser, but
# keeping the dialog-managed keys together makes them easy to find.

# Name and age of the chat character (NAME / AGE rows of the dialog). The
# stored persona below has its "your name is ..." sentence rewritten to match.
character-name = Onidia
character-age = 7

# Buddy character picked by the CHARACTER row's buttons (ONIDIA = the chibi
# girl, KAMA = the boy in the red hoodie). A running buddy keeps its character
# until it is quit with the pink Haiya! button and launched again.
character-gender = girl

# Sleep and busy windows, "HH:MM-HH:MM", set with the FROM/TO dropdowns.
sleep-time = 22:00-07:00
busy-time = 09:00-17:00

# Mute checkbox: while true replies are shown as bubbles but never spoken.
mute = false

# Thinking bubble checkbox: while "on" (the default) the reasoning behind a reply
# is drawn in the scalloped cloud above its bubble. Set to "off" to hide the
# cloud - the answer keeps its place in the transcript and only the cloud goes
# away. Written as on/off rather than true/false so a file with no "thinking" key
# keeps the cloud. Saving the dialog rewrites this key in place.
#
# It governs BOTH clouds: the window's above the answer, and the pet's own
# thought cloud, which she draws from the <THINKING> block on the say-pipe.
# Set to "off" and the block is no longer forwarded, so she stops showing it.
thinking = on

# Agents: pluggable abilities the model invokes with [AGENT: ...] reply tags.
# Each agent is a folder (agent.json + executable). The bundled ones ship in
# /opt/onidia/share/agents; your own live in ~/.config/chat-app/agents and win
# if they share an id. Manage them without leaving the app:
#   onidia-chat -agents-list                          what is installed, and what is off
#   onidia-chat -agents-install <folder|zip|url|id>   add one (no rebuild; restart picks it up)
#   onidia-chat -agents-remove <id>                   remove one of your own
# See agents/README.md for the authoring guide.
# agents-dir = /home/boi/.config/chat-app/agents
# agents-off = false
# Switch individual agents off without deleting them - useful for the packaged
# ones, which are root-owned in /opt and so cannot be edited in place. They stay
# on disk and come back when you remove the id from here.
# agents-disabled = play_movie, media_control

# Media folders for the built-in play_song / play_movie agents (flag names:
# -music-dir / -video-dir). Unset = the agents use ~/Music and ~/Videos.
# music-dir = ~/Music
# video-dir = ~/Videos

# Demo mode checkbox (the row directly below MUTE SPEECH): OFF (the default)
# keeps the buddy "planted" - it never wanders and never starts talking
# on its own, though it still blinks, idles and answers what you send it.
# Either way the buddy enters with its launch flourish (parachute /
# poof-in) and then walks - never running - to its parking spot three character widths in from the
# right edge, where its speech bubble is not clipped by the screen; planted
# mode then stays there. ON restores the classic demo behavior: the pet roams
# the screen and chatters randomly. Saving the dialog rewrites this key in
# place and restarts the buddy so the mode takes effect immediately.
demo-mode = false

# Auto-submit checkbox (the row beside DEMO MODE). OFF (the default) keeps the
# old hands-on flow: the mic button records, pressing it again stops, the
# transcript is typed into the input bar, and you read it and press SEND. That
# is the safer default, because a misheard sentence costs one click to fix
# rather than a reply already sent to the model.
#
# ON removes the last step: once the transcript lands it is shown for one
# second and then sent on its own, so a whole turn is mic-click, talk,
# mic-click. The one second is a grace window, not extra latency - it starts
# when the words arrive, not when you stop talking, so a slow transcription
# never eats into it. Type, backspace, press Escape, press the mic again or
# untick this box during that second and the prompt stays where it is.
#
# An empty take (silence) never arms the countdown, so it cannot fire a send
# with nothing in it. Saving the dialog rewrites this key in place.
auto-submit = false

# Auto-stop checkbox (the row below AUTO SUBMIT) - hands-free speech input. OFF
# (the default) is the flow above: click the mic, talk, click it again to stop.
#
# ON ends the take by itself when you stop talking, so a turn is click, talk,
# and nothing else. It works by watching the input level, not by asking a model:
# a take that has heard speech and then stays quiet for vadSilence (1.2s) is
# closed. Because there is no button to press, a transcript is sent straight
# after - enabling this implies auto-submit, which is the whole point. The
# setting is deliberately conservative:
#
#   * a take that has never heard anything is never ended, so a noisy room runs
#     to the 120-second cap instead of closing instantly on a hiss;
#   * a take must fall quiet for a full sentence pause, not a gap between words;
#   * the level is judged on the peak of each 20ms frame and relative to the
#     take's own loudest frame, so a quiet headset still counts as speech;
#   * the mic button shows a ring of dots for the input level while it decides,
#     which is the only way to tell "listening" from "cannot hear you".
#
# If takes get cut off mid-sentence, raise vadSilence. If they never stop, the
# room is too loud for a level threshold and the manual click still works.
auto-stop = false

